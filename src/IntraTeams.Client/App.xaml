<Application x:Class="IntraTeams.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:IntraTeams.Client.Infrastructure">
  <Application.Resources>
    <ResourceDictionary>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <infra:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
      <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
      <infra:BoolToAlignmentConverter x:Key="BoolToAlignment" />

      <!-- Palette -->
      <SolidColorBrush x:Key="Bg"        Color="#1F1F23" />
      <SolidColorBrush x:Key="BgPanel"   Color="#2A2A31" />
      <SolidColorBrush x:Key="BgRaised"  Color="#33333C" />
      <SolidColorBrush x:Key="Stroke"    Color="#3F3F4A" />
      <SolidColorBrush x:Key="Text"      Color="#F2F2F5" />
      <SolidColorBrush x:Key="TextMuted" Color="#9A9AA8" />
      <SolidColorBrush x:Key="Accent"    Color="#5B5BD6" />
      <SolidColorBrush x:Key="Success"   Color="#2E9E5B" />
      <SolidColorBrush x:Key="Danger"    Color="#C4384B" />

      <!-- Buttons -->
      <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource BgRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      </Style>

      <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Success}" />
        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
      </Style>

      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
      </Style>

      <!-- People list rows -->
      <Style x:Key="PersonItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                <ContentPresenter Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgRaised}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="14,12,14,6" />
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgRaised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="FontSize" Value="13" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
