<Window x:Class="IntraTeams.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IntraTeams"
        Height="760" Width="1240"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <!-- ============================================ people / presence ==== -->
    <Border Grid.Column="0" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="14,16,14,10">
          <TextBlock Text="IntraTeams" Foreground="{StaticResource Text}"
                     FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding MyDisplayName}" Foreground="{StaticResource TextMuted}"
                     FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="1" Background="#4A1F27" CornerRadius="6" Margin="10,0,10,6"
                Padding="10,8"
                Visibility="{Binding HasConnectionBanner, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding ConnectionBanner}" Foreground="#FFD3D9"
                     FontSize="11" TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="2" Text="PEOPLE ON THIS HUB" Style="{StaticResource SectionHeader}" />

        <Grid Grid.Row="3">
          <TextBlock Text="Nobody else is connected yet.&#x0a;Start the app on another machine."
                     Foreground="{StaticResource TextMuted}" FontSize="12"
                     TextAlignment="Center" TextWrapping="Wrap"
                     Margin="20" VerticalAlignment="Top">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding People.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ListBox ItemsSource="{Binding People}"
                   SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                   ItemContainerStyle="{StaticResource PersonItem}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0">
                    <Ellipse Fill="#4B4B8F" />
                    <TextBlock Text="{Binding Initials}" Foreground="White"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right"
                             VerticalAlignment="Bottom" Stroke="{StaticResource BgPanel}"
                             StrokeThickness="2">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="#2E9E5B" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                              <Setter Property="Fill" Value="#C4384B" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                  </Grid>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}"
                               FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PresenceText}" Foreground="{StaticResource TextMuted}"
                               FontSize="11" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </Border>

    <!-- ================================================== call surface ==== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="18,14" Background="{StaticResource Bg}">
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Text}"
                   FontSize="14" TextTrimming="CharacterEllipsis" />
      </Border>

      <!-- remote video, local preview, ringing overlay -->
      <Grid Grid.Row="1" Margin="18,0,18,0">
        <Border Background="#141418" CornerRadius="10"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
          <Grid>
            <Image Source="{Binding RemoteVideoSource}" Stretch="Uniform" Margin="2" />

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding RemoteVideoSource, Converter={StaticResource NullToVisibility}}">
              <TextBlock Text="No incoming video" Foreground="{StaticResource TextMuted}"
                         FontSize="14" HorizontalAlignment="Center" />
              <TextBlock Text="Audio-only calls show nothing here."
                         Foreground="#6C6C7A" FontSize="11" Margin="0,6,0,0"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- local preview -->
        <Border Width="212" Height="130" Margin="0,0,18,18"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#0E0E12" CornerRadius="8"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                Visibility="{Binding LocalVideoSource, Converter={StaticResource NotNullToVisibility}}">
          <Grid>
            <Image Source="{Binding LocalVideoSource}" Stretch="Uniform" Margin="2" />
            <Border Background="#99000000" CornerRadius="4" Padding="6,2"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
              <TextBlock Text="You" Foreground="White" FontSize="10" />
            </Border>
          </Grid>
        </Border>

        <!-- incoming call -->
        <Border Background="#DD1F1F23" CornerRadius="10"
                Visibility="{Binding IsRinging, Converter={StaticResource BoolToVisibility}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Ellipse Width="76" Height="76" Fill="#4B4B8F" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PeerDisplayName}" Foreground="{StaticResource Text}"
                       FontSize="19" FontWeight="SemiBold" Margin="0,18,0,4"
                       HorizontalAlignment="Center" />
            <TextBlock Text="is calling you" Foreground="{StaticResource TextMuted}"
                       FontSize="13" HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
              <Button Content="Accept" Style="{StaticResource SuccessButton}"
                      Command="{Binding AcceptCommand}" Padding="26,10" />
              <Button Content="Decline" Style="{StaticResource DangerButton}"
                      Command="{Binding RejectCommand}" Padding="26,10" Margin="0" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- controls -->
      <Border Grid.Row="2" Padding="18,16">
        <Grid>
          <!-- idle -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                      Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Audio call" Style="{StaticResource BaseButton}"
                    Command="{Binding AudioCallCommand}" Padding="22,10" />
            <Button Content="Video call" Style="{StaticResource AccentButton}"
                    Command="{Binding VideoCallCommand}" Padding="22,10" Margin="0" />
          </StackPanel>

          <!-- active -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                      Visibility="{Binding IsCallActive, Converter={StaticResource BoolToVisibility}}">
            <Button Content="{Binding MuteButtonText}" Style="{StaticResource BaseButton}"
                    Command="{Binding ToggleMuteCommand}" MinWidth="96" />
            <Button Content="{Binding CameraButtonText}" Style="{StaticResource BaseButton}"
                    Command="{Binding ToggleCameraCommand}" MinWidth="108" />
            <Button Content="{Binding ScreenShareButtonText}" Style="{StaticResource BaseButton}"
                    Command="{Binding ToggleScreenShareCommand}" MinWidth="120" />
            <Button Content="Hang up" Style="{StaticResource DangerButton}"
                    Command="{Binding HangUpCommand}" MinWidth="96" Margin="0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- diagnostics -->
      <Expander Grid.Row="3" Header="Connection log" Foreground="{StaticResource TextMuted}"
                Margin="18,0,18,14" FontSize="11">
        <Border Background="#141418" CornerRadius="6" Padding="8" Margin="0,6,0,0"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
          <ListBox ItemsSource="{Binding Diagnostics}" Height="120"
                   Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource TextMuted}"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Expander>
    </Grid>

    <!-- ============================================================ chat ==== -->
    <Border Grid.Column="2" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CHAT" Style="{StaticResource SectionHeader}" />

        <ListBox x:Name="ChatList" Grid.Row="1" ItemsSource="{Binding Chat}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="8,3" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="8" Padding="10,7" MaxWidth="240"
                      HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlignment}}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BgRaised}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMine}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Accent}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock Text="{Binding Sender}" Foreground="#C9C9D6"
                             FontSize="10" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Text}" Foreground="{StaticResource Text}"
                             FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding Timestamp}" Foreground="#9A9AA8"
                             FontSize="9.5" HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="10,6,10,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0"
                   Text="{Binding ChatDraft, UpdateSourceTrigger=PropertyChanged}"
                   VerticalContentAlignment="Center">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
            </TextBox.InputBindings>
          </TextBox>

          <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButton}"
                  Command="{Binding SendChatCommand}" Margin="8,0,0,0" Padding="14,7" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
